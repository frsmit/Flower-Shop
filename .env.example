# Copy this file to .env and fill it in. .env is gitignored, so nothing personal
# needs to be committed.
#
# READ THIS FIRST: these are build-time values. Vite inlines them into the
# JavaScript bundle, so they are NOT secret from visitors - they only stay out of
# your source. Anyone who opens the page can read every value here. Don't put
# anything in them you'd mind a stranger seeing.
#
# For a deploy, set the same names as GitHub Actions secrets:
#   Settings -> Secrets and variables -> Actions -> New repository secret

# Who the countdown is for.
VITE_BIRTHDAY_NAME=Bestie

# The moment it hits zero. KEEP THE OFFSET on the end (+05:30 is India) - without
# it the date is interpreted in the build machine's timezone, and CI runners are
# UTC, which would land it 5.5 hours late.
VITE_BIRTHDAY_DATE=2026-09-27T00:00:00+05:30

# How long the celebration screen stays up afterwards, in hours.
VITE_CELEBRATION_HOURS=24

# SHA-256 of the passphrase. Generate with:  npm run key -- "your phrase"
# Leave blank to remove the gate and land straight on the countdown.
VITE_SECRET_HASH=
VITE_SECRET_HINT=her favourite flower, all one word

# The letter. VITE_LETTER_OPENING defaults to "Dearest <name>,".
VITE_LETTER_OPENING=
VITE_LETTER_BODY=
VITE_LETTER_SIGNOFF=with love

# Shown on the day itself.
VITE_BIRTHDAY_TITLE=Happy Birthday
VITE_BIRTHDAY_MESSAGE=

# Her age. It is the first thing on the birthday page - it stands alone for a
# beat, then burns away into embers and the greeting takes its place.
# Leave it blank to skip that entirely and open straight on the greeting.
VITE_BIRTHDAY_AGE=

# The poem. One line unlocks per day, each carried in by a butterfly that then
# stays on the page; tapping one brings its line back. The LAST line is the
# birthday's own and never unlocks early, so write it as the closing one.
#
# The length sets when it starts: 28 lines begin unlocking 28 days out, 12 lines
# begin 12 days out. Separate lines with real newlines (keep the quotes) or
# with ' | ' on one line - whichever your editor makes less painful.
#
# Leave it blank for the bundled default in src/lib/poem.js. Same caveat as
# everything else here: this ends up readable in the shipped bundle, so treat
# the page as public.
VITE_POEM=""
